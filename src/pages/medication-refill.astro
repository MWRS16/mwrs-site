---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Medication Refill Request | MWRS"
  description="Request a refill for an existing prescription. Please allow 1–2 business days for processing."
>
  <main class="refill-page">

    <!-- Hero -->
    <section class="subpage-hero">
      <div class="section-inner">
        <h1>Medication Refill Request</h1>
        <p>
          Use this form to request a refill for an existing prescription.
          Please allow 1–2 business days for processing.
        </p>
        <a href="#refill-faq" class="btn-outline btn-outline--medication">
          Have questions? See below →
        </a>
      </div>
    </section>

    <!-- Form + FAQ -->
    <section class="refill-form-section">
      <div class="section-inner">

        <!-- Form card -->
        <article class="contact-card">
          <h2 class="contact-card-title">Refill request</h2>
          <form
            class="refill-form"
            method="POST"
            action="https://formspree.io/f/xwpgrywz"
          >
            <input type="hidden" name="_subject" value="Medication refill request" />

            <div class="field-grid">
              <div class="form-field">
                <label for="name">Name</label>
                <input id="name" name="name" type="text" autocomplete="name" required />
              </div>
              <div class="form-field">
                <label for="dob">Date of birth</label>
                <input id="dob" name="dob" type="date" required />
              </div>
            </div>

            <div class="field-grid">
              <div class="form-field">
                <label for="phone">Phone number</label>
                <input
                  id="phone"
                  name="phone"
                  type="tel"
                  autocomplete="tel"
                  inputmode="tel"
                  pattern="^\(?[0-9]{3}\)?[-.\s]?[0-9]{3}[-.\s]?[0-9]{4}$"
                  title="Please enter a valid 10-digit phone number"
                  required
                />
              </div>
              <div class="form-field">
                <label for="medication">Medication name</label>
                <input id="medication" name="medication" type="text" required />
              </div>
            </div>

            <div class="form-field">
              <label for="pharmacy">Pharmacy (name + location)</label>
              <input id="pharmacy" name="pharmacy" type="text" required />
            </div>

            <div class="form-field">
              <label for="notes">Additional notes (optional)</label>
              <textarea
                id="notes"
                name="notes"
                rows="4"
                placeholder="Anything else our team should know about this refill request?"
              ></textarea>
            </div>

            <button type="submit" class="btn-filled">
              Submit refill request
            </button>
          </form>
        </article>

        <!-- FAQ section -->
        <section class="refill-faq" id="refill-faq">
          <h2 class="contact-card-title">Common questions</h2>

          <details class="faq-item">
            <summary class="faq-question">How long does a refill take?</summary>
            <div class="faq-answer">
              <p>
                Please allow 1–2 business days for our team to review your
                request and respond with next steps. Not all requests can be
                filled immediately — some may require provider review or a
                follow-up appointment.
              </p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">What if I need it urgently?</summary>
            <div class="faq-answer">
              <p>
                Please submit refill requests at least <strong>1 week before</strong>
                your medication runs out.
              </p>
              <p>For urgent needs, call our office directly during business hours. If after hours, contact your pharmacy to request a temporary refill or visit urgent care if appropriate.</p>
              <p><strong>This form is not monitored for urgent requests.</strong></p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">Do I need an appointment?</summary>
            <div class="faq-answer">
              <p>
                Some refill requests require a follow-up visit. Our team will
                review your request and contact you within 1–2 business days
                if an appointment is needed.
              </p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">Can I request a new medication here?</summary>
            <div class="faq-answer">
              <p>
                No. This form is for refills of current or previously prescribed
                medications only.
              </p>
            </div>
          </details>
        </section>

      </div>
    </section>

  </main>

  <style>
    .refill-page {
      background: #f9fafb;
      min-height: 100vh;
      background-image: url("/images/paper-texture.png");
      background-repeat: repeat;
      background-size: 420px 420px;
    }

    /* Override global lavender divider — sage on this page */
    :global(.subpage-hero) {
      border-bottom-color: #6a9e8e !important;
    }

    /* ── Hero ─────────────────────────────────────────── */
    .subpage-hero {
      padding: 10rem 1.5rem 3.5rem;
      background-color: #fbfbf9;
      background-image: url("/images/paper-texture.png");
      background-repeat: repeat;
      background-size: 420px 420px;
      border-bottom: 1px solid rgba(15, 23, 42, 0.08);
      text-align: center;
    }

    .subpage-hero h1 {
      font-family: "Belleza", sans-serif;
      font-size: clamp(2rem, 3vw, 2.6rem);
      letter-spacing: 0.16em;
      text-transform: uppercase;
      margin: 0 0 1rem;
      color: #111827;
    }

    .subpage-hero p {
      margin: 0 0 1.2rem;
      font-size: 1rem;
      line-height: 1.7;
      color: #4b5563;
    }

    /* ── Outline button ───────────────────────────────── */
    .btn-outline {
      display: inline-block;
      width: fit-content;
      align-self: center;
      margin-top: 0.5rem;
      padding: 0.85rem 1.9rem;
      border-radius: 999px;
      border: 1px solid;
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      text-decoration: none;
      background: #ffffff;
      box-shadow: 0 6px 16px rgba(15, 23, 42, 0.12);
      transition: background 0.15s ease, color 0.15s ease,
        box-shadow 0.15s ease, transform 0.15s ease;
    }

    .btn-outline--medication {
      border-color: #6a9e8e;
      color: #6a9e8e;
    }

    .btn-outline--medication:hover {
      background: #6a9e8e;
      color: #ffffff;
      transform: translateY(-1px);
      box-shadow: 0 10px 24px rgba(106, 158, 142, 0.3);
    }

    /* ── Shared section wrapper ───────────────────────── */
    .section-inner {
      max-width: 900px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    /* ── Form section ─────────────────────────────────── */
    .refill-form-section {
      padding: 3.5rem 1.5rem 4rem;
    }

    /* ── Form card ────────────────────────────────────── */
    .contact-card {
      border-radius: 26px;
      background: #ffffff;
      box-shadow: 0 22px 50px rgba(15, 23, 42, 0.12);
      border: 1.5px solid rgba(138, 180, 164, 0.5);
      padding: 2.3rem 2.2rem 2.4rem;
    }

    .contact-card-title {
      margin: 0 0 1.1rem;
      font-size: 1.2rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-family: "Belleza", sans-serif;
      color: #111827;
    }

    /* ── Form fields ──────────────────────────────────── */
    .form-field {
      display: flex;
      flex-direction: column;
      margin-bottom: 1.05rem;
    }

    .field-grid {
      display: grid;
      gap: 1rem;
      margin-bottom: 0.4rem;
    }

    @media (min-width: 720px) {
      .field-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    label {
      font-size: 0.9rem;
      font-weight: 500;
      color: #111827;
      margin-bottom: 0.25rem;
    }

    input[type="text"],
    input[type="tel"],
    input[type="date"],
    textarea {
      border-radius: 999px;
      border: 1px solid rgba(15, 23, 42, 0.18);
      padding: 0.65rem 0.9rem;
      font-size: 0.9rem;
      font-family: inherit;
      background: #f9fafb;
      outline: none;
      transition: border-color 0.15s ease, box-shadow 0.15s ease,
        background 0.15s ease;
    }

    textarea {
      border-radius: 16px;
      resize: vertical;
      min-height: 120px;
    }

    input:focus,
    textarea:focus {
      border-color: #6a9e8e;
      background: #ffffff;
      box-shadow: 0 0 0 1px rgba(106, 158, 142, 0.2);
    }

    /* ── Submit button ────────────────────────────────── */
    .btn-filled {
      margin-top: 1.2rem;
      display: inline-block;
      border-radius: 999px;
      border: 1px solid #6a9e8e;
      padding: 0.9rem 1.9rem;
      font-size: 0.95rem;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      background: #6a9e8e;
      color: #ffffff;
      cursor: pointer;
      font-family: inherit;
      box-shadow: 0 9px 22px rgba(106, 158, 142, 0.3);
      transition: all 0.15s ease;
    }

    .btn-filled:hover {
      background: #598a7a;
      border-color: #598a7a;
      transform: translateY(-1px);
      box-shadow: 0 14px 32px rgba(106, 158, 142, 0.4);
    }

    /* ── FAQ section ──────────────────────────────────── */
    .refill-faq {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .faq-item {
      border-radius: 20px;
      background: #ffffff;
      border: 1.5px solid rgba(138, 180, 164, 0.5);
      box-shadow: 0 16px 40px rgba(15, 23, 42, 0.08);
      padding: 1.1rem 1.4rem;
    }

    .faq-item summary {
      list-style: none;
      cursor: pointer;
    }

    .faq-item summary::-webkit-details-marker {
      display: none;
    }

    .faq-question {
      font-size: 0.98rem;
      font-weight: 500;
      color: #111827;
      margin: 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.75rem;
    }

    .faq-item summary::after {
      content: "+";
      font-size: 1.2rem;
      color: #8ab4a4;
      flex-shrink: 0;
      transition: color 0.15s ease;
    }

    .faq-item[open] summary::after {
      content: "–";
      color: #6a9e8e;
    }

    .faq-answer {
      margin-top: 0.6rem;
      font-size: 0.94rem;
      line-height: 1.7;
      color: #4b5563;
    }

    .faq-answer p {
      margin: 0 0 0.6rem;
    }

    .faq-answer p:last-child {
      margin-bottom: 0;
    }

    @media (max-width: 720px) {
      .contact-card {
        padding: 1.8rem 1.4rem 2rem;
      }
    }
    /* CSS */
/* Override global lavender dividers — sage on this page */
:global(.subpage-hero) {
  border-bottom-color: #6a9e8e !important;
}

:global(.site-footer) {
  border-top-color: #6a9e8e !important;
}
  </style>
</Layout>