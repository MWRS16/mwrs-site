---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Start Counseling or Medication Care | MWRS"
  description="Tell us what you're looking for and our team will match you with a counselor or prescriber for counseling or medication management, in person or via telehealth in Idaho."
>
  <main class="contact-page">

    <!-- Hero -->
    <section class="contact-hero">
      <div class="section-inner">
        <h1>Start Counseling or Medication Care</h1>
        <p>
          Tell us a little about what you're looking for and our team will match
          you with a counselor or nurse practitioner. We offer in-person care in
          North Idaho and telehealth throughout the state.
        </p>

        <div class="contact-hero-buttons">
          <button type="button" class="btn-outline btn-outline--neutral" data-select-care="counseling">
            I'm looking for counseling
          </button>
          <button type="button" class="btn-outline btn-outline--neutral" data-select-care="medication">
            I'm looking for medication care
          </button>
          <button type="button" class="btn-outline btn-outline--neutral" data-select-care="both_care">
            I'm looking for counseling and medication care
          </button>
        </div>
      </div>
    </section>

    <!-- Form -->
    <section class="contact-form-section">
      <div class="section-inner">
        <article class="contact-card">
          <h2 class="contact-card-title">Tell us how we can help</h2>

          <p class="form-success" data-intake-success hidden>
            Thank you. Your information has been sent. Our intake team will
            follow up by phone or email, usually within 1–2 business days.
          </p>

          <form
            class="intake-form"
            method="POST"
            action="https://formspree.io/f/xwpgrywz"
          >
            <input type="hidden" name="_redirect" value="https://mwrservices.org/thank-you" />
            <input type="hidden" name="_subject" value="New intake request" />

            <div class="form-field">
              <label for="careType">What type of care are you seeking?</label>
              <select id="careType" name="care_type" required>
                <option value="">Please choose one…</option>
                <option value="counseling">Counseling</option>
                <option value="medication">Medication management</option>
                <option value="both_care">Counseling and medication management</option>
              </select>
            </div>

            <div class="field-grid">
              <div class="form-field">
                <label for="name">Name</label>
                <input id="name" name="name" type="text" autocomplete="name" required />
              </div>
              <div class="form-field">
                <label for="phone">Phone number</label>
                <input
                  id="phone"
                  name="phone"
                  type="tel"
                  autocomplete="tel"
                  inputmode="tel"
                  pattern="^\(?[0-9]{3}\)?[-.\s]?[0-9]{3}[-.\s]?[0-9]{4}$"
                  title="Please enter a valid 10-digit phone number"
                  required
                />
              </div>
            </div>

            <div class="field-grid">
              <div class="form-field">
                <label for="email">Email address</label>
                <input id="email" name="email" type="email" autocomplete="email" required />
              </div>
              <div class="form-field">
                <label for="dob">Date of birth</label>
                <input id="dob" name="date_of_birth" type="date" required />
              </div>
            </div>

            <div class="field-grid">
              <div class="form-field">
                <label for="preferredTime">Preferred time of day</label>
                <select id="preferredTime" name="preferred_time_of_day">
                  <option value="any_time">Any time</option>
                  <option value="morning">Morning</option>
                  <option value="afternoon">Afternoon</option>
                  <option value="after_4pm">After 4 PM</option>
                  <option value="evening">Evening</option>
                </select>
              </div>
              <div class="form-field">
                <label for="telehealth">Telehealth preference</label>
                <select id="telehealth" name="telehealth_preference" required>
                  <option value="">Please choose…</option>
                  <option value="in_person">In-person only</option>
                  <option value="telehealth_ok">Open to telehealth</option>
                  <option value="either">Either works</option>
                </select>
              </div>
            </div>

            <div class="form-field">
              <label for="insurance">Insurance</label>
              <select id="insurance" name="insurance" required>
                <option value="">Please choose…</option>
                <option value="cash_pay">Cash pay / self-pay</option>
                <option value="aetna">Aetna</option>
                <option value="blue_cross_idaho">Blue Cross of Idaho</option>
                <option value="bpa_eap">BPA EAP</option>
                <option value="champ_va">Champ VA</option>
                <option value="cigna_evernorth">Cigna/Evernorth</option>
                <option value="curalinc_eap">Curalinc EAP</option>
                <option value="first_choice">First Choice</option>
                <option value="gpa">GPA</option>
                <option value="humana">Humana</option>
                <option value="kaiser">Kaiser</option>
                <option value="magellan">Magellan</option>
                <option value="medicaid_idaho">Medicaid (Idaho)</option>
                <option value="medicare">Medicare</option>
                <option value="molina_idaho">Molina of Idaho</option>
                <option value="new_directions_eap">New Directions EAP</option>
                <option value="optum">Optum</option>
                <option value="pacific_source">Pacific Source</option>
                <option value="premera_blue_cross">Premera Blue Cross</option>
                <option value="regence_bcbs_any">Regence BCBS (Any State)</option>
                <option value="tricare_west">TriCare West</option>
                <option value="triwest_va">TriWest/VA</option>
                <option value="uhc">UHC</option>
                <option value="vital_eap">Vital EAP</option>
              </select>
            </div>

            <fieldset class="form-field office-fieldset">
              <legend>Preferred office</legend>
              <p class="field-hint">Please choose at least one option.</p>

              <div class="checkbox-grid office-grid office-grid--counseling" data-office-for="counseling both_care">
                <label><input type="checkbox" name="office_cda" value="Coeur d'Alene" data-office-option="counseling" /> Coeur d'Alene</label>
                <label><input type="checkbox" name="office_ponderay" value="Ponderay" data-office-option="counseling" /> Ponderay</label>
                <label><input type="checkbox" name="office_priest_river" value="Priest River" data-office-option="counseling" /> Priest River</label>
                <label><input type="checkbox" name="office_oldtown" value="Oldtown" data-office-option="counseling" /> Oldtown</label>
                <label><input type="checkbox" name="office_telehealth_only" value="Telehealth only" data-office-option="counseling" /> Telehealth only</label>
              </div>

              <div class="checkbox-grid office-grid office-grid--medication" data-office-for="medication">
                <label><input type="checkbox" name="office_cda_med" value="Coeur d'Alene" data-office-option="medication" /> Coeur d'Alene</label>
                <label><input type="checkbox" name="office_ponderay_med" value="Ponderay" data-office-option="medication" /> Ponderay</label>
                <label><input type="checkbox" name="office_telehealth_only_med" value="Telehealth only" data-office-option="medication" /> Telehealth only</label>
              </div>
            </fieldset>

            <div class="intake-subsection" data-section="counseling">
              <h3 class="subheading">Counseling details</h3>
              <div class="form-field">
                <label for="counselingType">What type of counseling are you seeking?</label>
                <select id="counselingType" name="counseling_type" data-required-when="counseling">
                  <option value="">Please choose…</option>
                  <option value="individual">Individual counseling</option>
                  <option value="couples">Couples counseling</option>
                  <option value="marriage">Marriage counseling</option>
                  <option value="family">Family counseling</option>
                  <option value="equine">Equine-assisted therapy</option>
                  <option value="other">Other / not sure</option>
                </select>
              </div>
              <div class="field-grid" id="couplesFields" hidden>
                <div class="form-field">
                  <label for="partnerName">Other participant's full name</label>
                  <input id="partnerName" name="partner_name" type="text" autocomplete="name" />
                </div>
                <div class="form-field">
                  <label for="partnerEmail">Other participant's email</label>
                  <input id="partnerEmail" name="partner_email" type="email" autocomplete="email" />
                </div>
              </div>
            </div>

            <div class="intake-subsection" data-section="medication">
              <h3 class="subheading">Medication management details</h3>
              <div class="field-grid">
                <div class="form-field">
                  <label for="prevDiagnosis">Have you received a mental health diagnosis before?</label>
                  <select id="prevDiagnosis" name="previous_diagnosis" data-required-when="medication">
                    <option value="">Please choose…</option>
                    <option value="yes">Yes</option>
                    <option value="no">No</option>
                    <option value="unsure">I'm not sure</option>
                  </select>
                </div>
                <div class="form-field">
                  <label for="currentMeds">Are you currently taking any psychiatric medication?</label>
                  <select id="currentMeds" name="current_medication" data-required-when="medication">
                    <option value="">Please choose…</option>
                    <option value="yes">Yes</option>
                    <option value="no">No</option>
                  </select>
                </div>
              </div>
              <div class="field-grid">
                <div class="form-field">
                  <label for="psychEval">Are you interested in a psychiatric evaluation?</label>
                  <select id="psychEval" name="psych_evaluation_interest" data-required-when="medication">
                    <option value="">Please choose…</option>
                    <option value="yes">Yes</option>
                    <option value="no">No</option>
                    <option value="unsure">Not sure yet</option>
                  </select>
                </div>
                <div class="form-field">
                  <label for="medConsult">Are you interested in ongoing medication management?</label>
                  <select id="medConsult" name="medication_management_interest" data-required-when="medication">
                    <option value="">Please choose…</option>
                    <option value="yes">Yes</option>
                    <option value="no">No</option>
                    <option value="unsure">Not sure yet</option>
                  </select>
                </div>
              </div>
            </div>

            <div class="intake-subsection" data-section="both_care">
              <h3 class="subheading">Counseling + medication details</h3>
              <div class="form-field">
                <label for="bothCareCounselingType">What type of counseling are you interested in?</label>
                <select id="bothCareCounselingType" name="both_care_counseling_type" data-required-when="both_care">
                  <option value="">Please choose…</option>
                  <option value="individual">Individual counseling</option>
                  <option value="cbt">CBT</option>
                  <option value="dbt">DBT</option>
                  <option value="emdr">EMDR</option>
                  <option value="marriage">Marriage counseling</option>
                  <option value="couples">Couples counseling</option>
                  <option value="family">Family counseling</option>
                  <option value="eft">EFT</option>
                  <option value="equine">Equine-assisted therapy</option>
                  <option value="other">Other / not sure</option>
                </select>
              </div>
              <div class="field-grid" id="bothCouplesFields" hidden>
                <div class="form-field">
                  <label for="bothPartnerName">Other participant's full name</label>
                  <input id="bothPartnerName" name="both_partner_name" type="text" autocomplete="name" />
                </div>
                <div class="form-field">
                  <label for="bothPartnerEmail">Other participant's email</label>
                  <input id="bothPartnerEmail" name="both_partner_email" type="email" autocomplete="email" />
                </div>
              </div>
              <div class="field-grid">
                <div class="form-field">
                  <label for="bothPrevDiagnosis">Have you received a mental health diagnosis before?</label>
                  <select id="bothPrevDiagnosis" name="both_previous_diagnosis" data-required-when="both_care">
                    <option value="">Please choose…</option>
                    <option value="yes">Yes</option>
                    <option value="no">No</option>
                    <option value="unsure">I'm not sure</option>
                  </select>
                </div>
                <div class="form-field">
                  <label for="bothCurrentMeds">Are you currently taking any psychiatric medication?</label>
                  <select id="bothCurrentMeds" name="both_current_medication" data-required-when="both_care">
                    <option value="">Please choose…</option>
                    <option value="yes">Yes</option>
                    <option value="no">No</option>
                  </select>
                </div>
              </div>
              <div class="field-grid">
                <div class="form-field">
                  <label for="bothPsychEval">Are you interested in a psychiatric evaluation?</label>
                  <select id="bothPsychEval" name="both_psych_evaluation_interest" data-required-when="both_care">
                    <option value="">Please choose…</option>
                    <option value="yes">Yes</option>
                    <option value="no">No</option>
                    <option value="unsure">Not sure yet</option>
                  </select>
                </div>
                <div class="form-field">
                  <label for="bothMedConsult">Are you interested in ongoing medication management?</label>
                  <select id="bothMedConsult" name="both_medication_management_interest" data-required-when="both_care">
                    <option value="">Please choose…</option>
                    <option value="yes">Yes</option>
                    <option value="no">No</option>
                    <option value="unsure">Not sure yet</option>
                  </select>
                </div>
              </div>
            </div>

            <div class="form-field">
              <label for="goals">Briefly describe what you're hoping to work on</label>
              <textarea
                id="goals"
                name="goals"
                rows="4"
                placeholder="You can keep this brief. We'll talk more about the details in your first visit."
                required
              ></textarea>
            </div>

            <fieldset class="form-field acknowledgements">
              <legend>Before you submit</legend>
              <label class="checkbox-inline">
                <input type="checkbox" name="acknowledge_not_emergency" value="yes" required />
                I understand this form is not for emergencies and does not guarantee services.
              </label>
              <label class="checkbox-inline">
                <input type="checkbox" name="consent_contact" value="yes" required />
                I consent to MWRS contacting me by phone or email regarding this inquiry.
              </label>
            </fieldset>

            <button type="submit" class="btn-filled">Submit request</button>
          </form>
        </article>
      </div>
    </section>

  </main>

  <style>
    .contact-page {
      background: #f9fafb;
      min-height: 100vh;
      background-image: url("/images/paper-texture.png");
      background-repeat: repeat;
      background-size: 420px 420px;
    }

    /* ── Hero ─────────────────────────────────────────── */
    .contact-hero {
      padding: 10rem 1.5rem 3.5rem;
      background-color: #fbfbf9;
      background-image: url("/images/paper-texture.png");
      background-repeat: repeat;
      background-size: 420px 420px;
      border-bottom: 1px solid rgba(15, 23, 42, 0.08);
      text-align: center;
    }

    .contact-hero h1 {
      font-family: "Belleza", sans-serif;
      font-size: clamp(2rem, 3vw, 2.6rem);
      letter-spacing: 0.16em;
      text-transform: uppercase;
      margin: 0 0 1rem;
      color: #111827;
    }

    .contact-hero p {
      margin: 0 0 1.8rem;
      font-size: 1rem;
      line-height: 1.7;
      color: #4b5563;
    }

    .contact-hero-buttons {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.75rem;
    }

    /* ── Shared section wrapper ───────────────────────── */
    .section-inner {
      max-width: 900px;
      margin: 0 auto;
    }

    /* ── Outline buttons ──────────────────────────────── */
    .btn-outline {
      display: inline-block;
      border-radius: 999px;
      border: 1px solid;
      padding: 0.7rem 1.7rem;
      background: #ffffff;
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      text-decoration: none;
      cursor: pointer;
      font-family: inherit;
      transition: all 0.15s ease;
    }

    .btn-outline--counseling {
      border-color: #7d6fb3;
      color: #7d6fb3;
    }

    .btn-outline--counseling:hover {
      background: #7d6fb3;
      color: #ffffff;
      transform: translateY(-1px);
      box-shadow: 0 9px 24px rgba(125, 111, 179, 0.25);
    }

    .btn-outline--medication {
      border-color: #6a9e8e;
      color: #6a9e8e;
    }

    .btn-outline--medication:hover {
      background: #6a9e8e;
      color: #ffffff;
      transform: translateY(-1px);
      box-shadow: 0 9px 24px rgba(106, 158, 142, 0.25);
    }

    .btn-outline--neutral {
      border-color: #111827;
      color: #111827;
    }

    .btn-outline--neutral:hover {
      background: #111827;
      color: #ffffff;
      transform: translateY(-1px);
      box-shadow: 0 9px 24px rgba(15, 23, 42, 0.2);
    }

    /* Hero choice buttons — all black at rest, color reveals on hover */
    [data-select-care="counseling"]:hover {
      background: #7d6fb3 !important;
      border-color: #7d6fb3 !important;
      color: #ffffff !important;
      box-shadow: 0 9px 24px rgba(125, 111, 179, 0.25) !important;
    }

    [data-select-care="medication"]:hover {
      background: #6a9e8e !important;
      border-color: #6a9e8e !important;
      color: #ffffff !important;
      box-shadow: 0 9px 24px rgba(106, 158, 142, 0.25) !important;
    }

    /* ── Form section ─────────────────────────────────── */
    .contact-form-section {
      padding: 3.5rem 1.5rem 4rem;
    }

    .contact-card {
      border-radius: 26px;
      background: #ffffff;
      box-shadow: 0 22px 50px rgba(15, 23, 42, 0.12);
      border: 1.5px solid rgba(155, 142, 196, 0.5);
      padding: 2.3rem 2.2rem 2.4rem;
    }

    .contact-card-title {
      margin: 0 0 1.1rem;
      font-size: 1.2rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-family: "Belleza", sans-serif;
      color: #111827;
    }

    .form-success {
      margin: 0 0 1.2rem;
      padding: 0.75rem 1rem;
      border-radius: 999px;
      background: #ecfdf5;
      color: #166534;
      font-size: 0.85rem;
      text-align: center;
    }

    /* ── Form fields ──────────────────────────────────── */
    .form-field {
      display: flex;
      flex-direction: column;
      margin-bottom: 1.05rem;
    }

    .form-field.small {
      margin-top: 1.2rem;
    }

    .field-grid {
      display: grid;
      gap: 1rem;
      margin-bottom: 0.4rem;
    }

    @media (min-width: 720px) {
      .field-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    label,
    legend {
      font-size: 0.9rem;
      font-weight: 500;
      color: #111827;
      margin-bottom: 0.25rem;
    }

    .field-hint {
      margin: 0 0 0.4rem;
      font-size: 0.8rem;
      color: #6b7280;
    }

    input[type="text"],
    input[type="tel"],
    input[type="email"],
    input[type="date"],
    select,
    textarea {
      border-radius: 999px;
      border: 1px solid rgba(15, 23, 42, 0.18);
      padding: 0.65rem 0.9rem;
      font-size: 0.9rem;
      font-family: inherit;
      background: #f9fafb;
      outline: none;
      transition: border-color 0.15s ease, box-shadow 0.15s ease,
        background 0.15s ease;
    }

    textarea {
      border-radius: 16px;
      resize: vertical;
      min-height: 120px;
    }

    input:focus,
    select:focus,
    textarea:focus {
      border-color: #7d6fb3;
      background: #ffffff;
      box-shadow: 0 0 0 1px rgba(125, 111, 179, 0.2);
    }

    .office-fieldset,
    .acknowledgements {
      border: 1px solid rgba(15, 23, 42, 0.18);
      border-radius: 16px;
      padding: 0.9rem 1rem 1rem;
      margin-bottom: 1.2rem;
      background: #ffffff;
    }

    .checkbox-grid {
      display: grid;
      gap: 0.35rem;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    }

    .checkbox-grid label,
    .checkbox-inline {
      font-size: 0.8rem;
      font-weight: 400;
      color: #374151;
    }

    .checkbox-inline {
      display: flex;
      align-items: flex-start;
      gap: 0.4rem;
      margin-bottom: 0.45rem;
    }

    .checkbox-inline input,
    .checkbox-grid input {
      margin-top: 0.2rem;
    }

    .subheading {
      margin: 1.4rem 0 0.5rem;
      font-size: 0.9rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: #7d6fb3;
      font-family: "Belleza", sans-serif;
    }

    .intake-subsection[hidden] {
      display: none;
    }

    /* ── Submit button ────────────────────────────────── */
    /* ── Filled button — for low-contrast sections ───── */
    .btn-filled {
      display: inline-block;
      padding: 0.6rem 1.4rem;
      border-radius: 999px;
      background: #ffffff;
      color: #52468a;
      border: 1.5px solid #52468a;
      text-decoration: none;
      font-size: 1.2rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      transition: all 0.15s ease;
    }

    .btn-filled:hover {
      background: #7d6fb3;
      color: #ffffff;
      transform: translateY(-1px);
      box-shadow: 0 10px 24px rgba(15, 23, 42, 0.25);
    }

    /* ── Select dropdown arrow ────────────────────────── */
    .contact-card select {
      appearance: none;
      -webkit-appearance: none;
      background-image: url("data:image/svg+xml,%3Csvg fill='none' stroke='%236b7280' stroke-width='2' viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath stroke-linecap='round' stroke-linejoin='round' d='M19 9l-7 7-7-7'/%3E%3C/svg%3E");
      background-repeat: no-repeat;
      background-size: 16px;
      background-position: right 1rem center;
      padding-right: 2.8rem !important;
    }

    .contact-card select:focus {
      background-image: url("data:image/svg+xml,%3Csvg fill='none' stroke='%237d6fb3' stroke-width='2' viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath stroke-linecap='round' stroke-linejoin='round' d='M19 9l-7 7-7-7'/%3E%3C/svg%3E");
    }

    #couplesFields,
    #bothCouplesFields {
      display: none;
    }

    @media (max-width: 720px) {
      .contact-card {
        padding: 1.8rem 1.4rem 2rem;
      }
    }
  </style>

  <script type="module">
    const careSelect = document.querySelector("#careType");
    const subsections = document.querySelectorAll(".intake-subsection");
    const requiredFields = document.querySelectorAll("[data-required-when]");
    const heroButtons = document.querySelectorAll("[data-select-care]");
    const formSection = document.querySelector(".contact-form-section");
    const officeGrids = document.querySelectorAll(".office-grid");
    const intakeForm = document.querySelector(".intake-form");
    const successMsg = document.querySelector("[data-intake-success]");
    const submitBtn = document.querySelector(".btn-filled");

    const counselingTypeSelect = document.querySelector("#counselingType");
    const couplesFields = document.querySelector("#couplesFields");
    const partnerName = document.querySelector("#partnerName");
    const partnerEmail = document.querySelector("#partnerEmail");

    const bothCareCounselingTypeSelect = document.querySelector("#bothCareCounselingType");
    const bothCouplesFields = document.querySelector("#bothCouplesFields");
    const bothPartnerName = document.querySelector("#bothPartnerName");
    const bothPartnerEmail = document.querySelector("#bothPartnerEmail");

    function updateCareView() {
      const value = careSelect ? careSelect.value : "";
      subsections.forEach((section) => {
        section.hidden = section.dataset.section !== value;
      });
      requiredFields.forEach((field) => {
        const modes = field.dataset.requiredWhen.split(",");
        field.required = modes.includes(value);
      });
      officeGrids.forEach((grid) => {
        const modes = grid.dataset.officeFor.split(" ");
        grid.style.display = modes.includes(value) ? "grid" : "none";
      });
      updateCouplesFields();
      updateBothCouplesFields();
    }

    function updateCouplesFields() {
      const isCouples =
        careSelect?.value === "counseling" &&
        ["couples", "marriage"].includes(counselingTypeSelect?.value);
      if (couplesFields) couplesFields.style.display = isCouples ? "grid" : "none";
      if (partnerName) { partnerName.required = isCouples; if (!isCouples) partnerName.value = ""; }
      if (partnerEmail) { partnerEmail.required = isCouples; if (!isCouples) partnerEmail.value = ""; }
    }

    function updateBothCouplesFields() {
      const isCouples =
        careSelect?.value === "both_care" &&
        ["couples", "marriage"].includes(bothCareCounselingTypeSelect?.value);
      if (bothCouplesFields) bothCouplesFields.style.display = isCouples ? "grid" : "none";
      if (bothPartnerName) { bothPartnerName.required = isCouples; if (!isCouples) bothPartnerName.value = ""; }
      if (bothPartnerEmail) { bothPartnerEmail.required = isCouples; if (!isCouples) bothPartnerEmail.value = ""; }
    }

    function getActiveOfficeInputs(careType) {
      if (!intakeForm) return [];
      if (careType === "medication") return intakeForm.querySelectorAll('input[data-office-option="medication"]');
      if (careType === "counseling" || careType === "both_care") return intakeForm.querySelectorAll('input[data-office-option="counseling"]');
      return [];
    }

    function validateOfficeSelection(careType) {
      const officeInputs = getActiveOfficeInputs(careType);
      if (!officeInputs.length) return true;
      const oneChecked = Array.from(officeInputs).some((input) => input.checked);
      officeInputs.forEach((input) => {
        input.setCustomValidity(oneChecked ? "" : "Please choose at least one office option.");
      });
      if (!oneChecked) officeInputs[0].reportValidity();
      return oneChecked;
    }

    if (careSelect) careSelect.addEventListener("change", updateCareView);
    if (counselingTypeSelect) counselingTypeSelect.addEventListener("change", updateCouplesFields);
    if (bothCareCounselingTypeSelect) bothCareCounselingTypeSelect.addEventListener("change", updateBothCouplesFields);

    heroButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        if (!careSelect) return;
        careSelect.value = btn.dataset.selectCare;
        updateCareView();
        formSection?.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });

    if (careSelect) {
      updateCareView();
    } else {
      updateCouplesFields();
      updateBothCouplesFields();
    }

    if (intakeForm) {
      const officeInputs = intakeForm.querySelectorAll("input[data-office-option]");
      officeInputs.forEach((input) => {
        input.addEventListener("change", () => {
          if (careSelect) validateOfficeSelection(careSelect.value);
        });
      });

      intakeForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        const careType = careSelect ? careSelect.value : "";
        if (!validateOfficeSelection(careType)) return;

        const formData = new FormData(intakeForm);
        let subject = "New intake request";
        if (careType === "counseling") subject = "New intake: Counseling request";
        else if (careType === "medication") subject = "New intake: Medication management request";
        else if (careType === "both_care") subject = "New intake: Counseling + medication management request";
        formData.set("_subject", subject);

        if (submitBtn) submitBtn.disabled = true;

        try {
          const response = await fetch(intakeForm.action, {
            method: "POST",
            body: formData,
            headers: { Accept: "application/json" },
          });
          if (response.ok) {
            intakeForm.reset();
            if (careSelect) careSelect.value = "";
            updateCareView();
            if (successMsg) successMsg.hidden = false;
          } else {
            console.error("Formspree error", await response.text());
          }
        } catch (err) {
          console.error("Network error", err);
        } finally {
          if (submitBtn) submitBtn.disabled = false;
        }
      });
    }
  </script>
</Layout>