---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Counseling & Medication Management in Idaho | Mental Wellness & Relationship Services"
  description="MWRS provides mental health counseling and psychiatric medication management for individuals, couples, and families across Idaho, with in-person and telehealth options."
>
  <!-- Hero -->
  <section class="hero">
    <video
      class="hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="none"
      poster="/images/mwrs-home-hero-poster.webp"
    >
      <source src="/videos/mwrs-bg-looped-small.mp4" type="video/mp4" />
    </video>

    <div class="hero-inner">
      <div class="hero-text">
        <h1>A STEADIER WAY FORWARD</h1>
        <p>
          Counseling and psychiatric medication management in Coeur d'Alene,
          Idaho. Thoughtful care for individuals, couples, and families.
        </p>
        <a href="/contact-us" class="btn-hero">Contact Us</a>
      </div>
    </div>
  </section>

  <!-- Service paths -->
  <section class="service-paths">
    <div class="service-paths-inner">
      <div class="service-paths-grid">
        <!-- Counseling card — lavender -->
        <a href="/contact-us" class="card-wrap">
          <article class="card card--counseling">
            <p class="card-kicker">Counseling &amp; Therapy</p>
            <h2 class="card-title">Meet with a counselor</h2>
            <p class="card-text">
              Individual, couples, and family counseling in Coeur d'Alene,
              Priest River, Ponderay, and Oldtown, with teletherapy available
              anywhere in Idaho.
            </p>
            <span class="btn-outline btn-outline--counseling">
              Request a counseling appointment →
            </span>
          </article>
        </a>

        <!-- Medication card — sage -->
        <a href="/psychiatry" class="card-wrap">
          <article class="card card--medication">
            <p class="card-kicker card-kicker--medication">
              Medication Management
            </p>
            <h2 class="card-title">Meet with a prescriber</h2>
            <p class="card-text">
              Medication support for anxiety, depression, ADHD, and related
              concerns — with in-person visits in Coeur d'Alene and Ponderay,
              plus telehealth across Idaho.
            </p>
            <span class="btn-outline btn-outline--medication">
              Request a medication appointment →
            </span>
          </article>
        </a>
      </div>
    </div>
  </section>

  <!-- Team strip -->
  <section class="team-strip">
    <div class="team-strip-inner">
      <p class="team-kicker">Our People</p>
      <h2 class="team-heading">Meet the team</h2>
      <div class="team-grid">
        <a href="/our-team#violet-rudd" class="team-member">
          <div class="team-avatar">
            <img
              src="/images/providers/violet-rudd.jpg"
              alt="Violet Rudd"
              loading="lazy"
            />
          </div>
          <p class="team-name">Violet Rudd</p>
          <p class="team-role">LMFT, Clinical Director</p>
        </a>

        <a href="/our-team#jared-bruder" class="team-member">
          <div class="team-avatar">
            <img
              src="/images/providers/jared-bruder.jpg"
              alt="Jared Bruder"
              loading="lazy"
              style="object-position: center 20%;"
            />
          </div>
          <p class="team-name">Jared Bruder</p>
          <p class="team-role">PMHNP</p>
        </a>

        <a href="/our-team#duann-chambers" class="team-member">
          <div class="team-avatar">
            <img
              src="/images/providers/duann-chambers.jpg"
              alt="DuAnn Chambers"
              loading="lazy"
            />
          </div>
          <p class="team-name">DuAnn Chambers</p>
          <p class="team-role">LMFT</p>
        </a>

        <a href="/our-team#perry-broomfield" class="team-member">
          <div class="team-avatar">
            <img
              src="/images/providers/perry-broomfield.jpg"
              alt="Perry Broomfield"
              loading="lazy"
            />
          </div>
          <p class="team-name">Perry Broomfield</p>
          <p class="team-role">LMSW</p>
        </a>

        <a href="/our-team#kevin-dayton" class="team-member">
          <div class="team-avatar">
            <img
              src="/images/providers/kevin-dayton.jpg"
              alt="Kevin Dayton"
              loading="lazy"
              style="object-position: center 20%;"
            />
          </div>
          <p class="team-name">Kevin Dayton</p>
          <p class="team-role">LCSW</p>
        </a>

        <a href="/our-team#mark-tetzlaff" class="team-member">
          <div class="team-avatar">
            <img
              src="/images/providers/mark-tetzlaff.jpg"
              alt="Mark Tetzlaff"
              loading="lazy"
            />
          </div>
          <p class="team-name">Mark Tetzlaff</p>
          <p class="team-role">LMSW</p>
        </a>

        <a href="/our-team#beverly-oh" class="team-member">
          <div class="team-avatar">
            <img
              src="/images/providers/beverly-oh.jpg"
              alt="Beverly Oh"
              loading="lazy"
            />
          </div>
          <p class="team-name">Beverly Oh</p>
          <p class="team-role">LPC</p>
        </a>

        <a href="/our-team#brandi-sanchez" class="team-member">
          <div class="team-avatar">
            <img
              src="/images/providers/BrandiSanchez.jpg"
              alt="Brandi Sanchez"
              loading="lazy"
              style="object-position: center 20%;"
            />
          </div>
          <p class="team-name">Brandi Sanchez</p>
          <p class="team-role">LMSW</p>
        </a>

        <a href="/our-team#zusje-greeff" class="team-member">
          <div class="team-avatar">
            <img
              src="/images/providers/zusje-greeff.jpeg"
              alt="Zusje Greeff"
              loading="lazy"
              style="object-position: center 10%;"
            />
          </div>
          <p class="team-name">Zusje Greeff</p>
          <p class="team-role">LMSW</p>
        </a>
      </div>
      <a href="/our-team" class="team-cta">Meet the full team →</a>
    </div>
  </section>

  <!-- Care guidance -->
  <section class="care-guidance">
    <div class="care-guidance-inner">
      <a href="/contact-us" class="care-guidance-link">
        <div class="care-guidance-card">
          <h2>Not sure where to start?</h2>
          <p>
            Some people are looking for counseling. Others want to explore
            whether medication could help with anxiety, depression, ADHD, or
            other concerns. We can help you figure out the right starting point.
          </p>
          <span class="btn-filled">Get Started →</span>
        </div>
      </a>
    </div>
  </section>

  <!-- About -->
  <section class="about-mwrs">
    <div class="about-inner">
      <h2>Thoughtful mental health care in North Idaho</h2>
      <p>
        Mental Wellness &amp; Relationship Services (MWRS) provides counseling,
        equine-assisted therapy, and psychiatric medication management to
        individuals, couples, and families across North Idaho from our offices
        in Coeur d'Alene, Priest River, Ponderay, and Oldtown — with telehealth
        available statewide.
      </p>
    </div>
  </section>

  <style>
    /* ── Hero ─────────────────────────────────────────── */
    .hero {
      position: relative;
      min-height: 75vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      color: #e5e7eb;
      padding: 6rem 1.5rem 3rem;
      border-bottom: none;
    }

    .hero::before {
      content: "";
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.1);
      z-index: 1;
    }

    .hero-video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 40%;
      filter: brightness(0.8) contrast(1.1) saturate(1.05);
    }

    .hero-inner {
      position: relative;
      z-index: 10;
      max-width: 900px;
      width: 100%;
    }

    .hero-text {
      max-width: 640px;
      margin: 0 auto;
      text-align: center;
    }

    .hero-text h1 {
      font-family: "Belleza", sans-serif;
      font-size: clamp(2.2rem, 4vw, 3rem);
      line-height: 1.1;
      margin-bottom: 1rem;
      letter-spacing: 0.02em;
      font-weight: 400;
      color: #ffffff;
    }

    .hero-text p {
      font-size: 1rem;
      line-height: 1.6;
      margin-bottom: 1.5rem;
      color: #ffffff;
      font-weight: 300;
      letter-spacing: 0.015em;
    }

    .btn-hero {
      display: inline-block;
      padding: 1rem 1.75rem;
      border: 2px solid #ffffff;
      background: transparent;
      color: #ffffff;
      text-decoration: none;
      border-radius: 4px;
      font-size: 1.75rem;
      letter-spacing: 0.05em;
      font-weight: 300;
      transition: all 0.2s ease;
    }

    .btn-hero:hover {
      background: rgba(255, 255, 255, 0.1);
    }

    /* ── Shared section backgrounds ───────────────────── */
    .service-paths,
    .team-strip,
    .care-guidance,
    .about-mwrs {
      background-image: url("/images/paper-texture.webp");
      background-repeat: repeat;
      background-size: 420px 420px;
      border-bottom: 1px solid rgba(15, 23, 42, 0.08);
    }

    /* ── Service paths ────────────────────────────────── */
    .service-paths {
      padding: 3.5rem 1.5rem 2.5rem;
      background-color: #fbfbf9;
      border-radius: 24px 24px 0 0;
      margin-top: -24px;
      position: relative;
      z-index: 2;
      border-top: 3px solid #9b8ec4;
    }

    .service-paths-inner {
      max-width: 1100px;
      margin: 0 auto;
    }

    .service-paths-grid {
      display: grid;
      gap: 2rem;
      align-items: stretch;
    }

    @media (min-width: 900px) {
      .service-paths-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    /* ── Cards ────────────────────────────────────────── */
    .card-wrap {
      display: flex;
      text-decoration: none;
      color: inherit;
    }

    .card {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      border-radius: 22px;
      padding: 2.1rem 2rem;
      background: #ffffff;
      box-shadow: 0 18px 40px rgba(15, 23, 42, 0.1);
      transition:
        transform 0.18s ease,
        box-shadow 0.18s ease;
      cursor: pointer;
    }

    .card--counseling {
      border: 1.5px solid rgba(155, 142, 196, 0.5);
    }

    .card--medication {
      border: 1.5px solid rgba(138, 180, 164, 0.5);
    }

    .card:hover {
      transform: translateY(-4px);
      box-shadow: 0 22px 55px rgba(15, 23, 42, 0.16);
    }

    /* ── Card kicker labels ───────────────────────────── */
    .card-kicker {
      margin: 0;
      font-family: "Belleza", sans-serif;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      font-size: 0.8rem;
      color: #5f529b;
    }

    .card-kicker--medication {
      color: #4f7a6a;
    }

    .card-title {
      margin: 0;
      font-size: 1.15rem;
      color: #111827;
    }

    .card-text {
      margin: 0.25rem 0 0.75rem;
      line-height: 1.7;
      color: #374151;
      font-size: 0.95rem;
    }

    /* ── Outline buttons ──────────────────────────────── */
    .btn-outline {
      margin-top: auto;
      display: inline-block;
      padding: 0.6rem 1.4rem;
      border-radius: 999px;
      border: 1px solid;
      text-decoration: none;
      font-size: 0.85rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      transition: all 0.15s ease;
    }

    .btn-outline--counseling {
      border-color: #52468a;
      color: #52468a;
    }

    .btn-outline--counseling:hover,
    .card--counseling:hover .btn-outline--counseling {
      background: #7d6fb3;
      color: #ffffff;
    }

    .btn-outline--medication {
      border-color: #4f7a6a;
      color: #4f7a6a;
    }

    .btn-outline--medication:hover,
    .card--medication:hover .btn-outline--medication {
      background: #6a9e8e;
      color: #ffffff;
    }

    /* ── Team strip ──────────────────────────────────────── */
    .team-strip {
      background-color: #fbfbf9;
      padding: 3.5rem 1.5rem 3rem;
    }

    .team-strip-inner {
      max-width: 1100px;
      margin: 0 auto;
      text-align: center;
    }

    .team-kicker {
      margin: 0 0 0.4rem;
      font-family: "Belleza", sans-serif;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      font-size: 0.8rem;
      color: #5f529b;
    }

    .team-heading {
      margin: 0 0 2.5rem;
      font-family: "Belleza", sans-serif;
      font-size: 1.4rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #111827;
    }

    .team-grid {
      display: grid;
      grid-template-columns: repeat(9, minmax(0, 1fr));
      gap: 1.5rem;
      margin-bottom: 2rem;
    }

    .team-member {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      color: inherit;
    }

    .team-avatar {
      width: 88px;
      height: 88px;
      border-radius: 50%;
      overflow: hidden;
      border: 3px solid #ffffff;
      box-shadow: 0 4px 12px rgba(15, 23, 42, 0.1);
      flex-shrink: 0;
      transition:
        box-shadow 0.18s ease,
        transform 0.18s ease;
    }

    .team-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
    }

    .team-member:hover .team-avatar {
      box-shadow: 0 6px 20px rgba(15, 23, 42, 0.18);
      transform: translateY(-2px);
    }

    .team-name {
      margin: 0;
      font-size: 0.78rem;
      font-weight: 500;
      color: #111827;
      line-height: 1.3;
    }

    .team-role {
      margin: 0;
      font-size: 0.7rem;
      color: #52468a;
      line-height: 1.3;
    }

    .team-cta {
      display: inline-block;
      border: 1px solid #52468a;
      color: #52468a;
      font-size: 0.9rem;
      padding: 0.6rem 1.6rem;
      border-radius: 999px;
      text-decoration: none;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      transition: all 0.15s ease;
    }

    .team-cta:hover {
      background: #7d6fb3;
      color: #ffffff;
    }

    @media (max-width: 1024px) {
      .team-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.5rem 1rem;
      }

      .team-avatar {
        width: 72px;
        height: 72px;
      }
    }

    /* ── Care guidance ────────────────────────────────── */
    .care-guidance {
      padding: 2.5rem 1.5rem;
      background-color: #fbfbf9;
    }

    .care-guidance-inner {
      max-width: 760px;
      margin: 0 auto;
    }

    .care-guidance-link {
      display: block;
      text-decoration: none;
      color: inherit;
    }

    .care-guidance-card {
      background: #ffffff;
      border-radius: 22px;
      padding: 2.5rem 2rem;
      border: 1.5px solid rgba(15, 23, 42, 0.5);
      box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
      text-align: center;
      transition:
        transform 0.18s ease,
        box-shadow 0.18s ease;
    }

    .care-guidance-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 22px 55px rgba(15, 23, 42, 0.16);
    }

    .care-guidance h2 {
      margin: 0 0 0.75rem;
      font-family: "Belleza", sans-serif;
      font-size: 1.2rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #111827;
    }

    .care-guidance p {
      margin: 0 auto 1rem;
      font-size: 1rem;
      line-height: 1.7;
      color: #4b5563;
    }

    /* ── Filled button ────────────────────────────────── */
    .btn-filled {
      display: inline-block;
      padding: 0.6rem 1.4rem;
      border-radius: 999px;
      background: transparent;
      color: #0f172a;
      border: 1px solid #0f172a;
      text-decoration: none;
      font-size: 0.85rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      transition: all 0.15s ease;
    }

    .btn-filled:hover,
    .care-guidance-card:hover .btn-filled {
      background: #0f172a;
      color: #ffffff;
      transform: translateY(-1px);
      box-shadow: 0 10px 24px rgba(15, 23, 42, 0.25);
    }

    /* ── About ────────────────────────────────────────── */
    .about-mwrs {
      padding: 2.75rem 1.5rem 3.25rem;
      background-color: #fbfbf9;
    }

    .about-inner {
      max-width: 900px;
      margin: 0 auto;
      text-align: center;
    }

    .about-mwrs h2 {
      margin: 0 0 1rem;
      font-family: "Belleza", sans-serif;
      font-size: 1.4rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .about-mwrs p {
      margin: 0;
      font-size: 0.98rem;
      line-height: 1.7;
      color: #4b5563;
    }

    /* ── Mobile hero ─────────────────────────────────── */
    @media (max-width: 1024px) {
      .hero-video {
        display: none;
      }

      .hero {
        background-image: url("/images/mwrs-mobile-poster.webp");
        background-size: cover;
        background-position: center top;
        min-height: 60vh;
      }

      .hero::before {
        background: rgba(0, 0, 0, 0.38);
      }

      .hero-inner {
        z-index: 2;
      }
    }
  </style>
</Layout>
