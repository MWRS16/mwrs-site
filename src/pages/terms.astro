---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Terms of Use | Mental Wellness & Relationship Services (MWRS)"
  description="Terms of Use for the Mental Wellness & Relationship Services (MWRS) website, including policies on content use, liability, and website access."
>
  <main class="terms-page">

    <!-- Hero -->
    <section class="subpage-hero">
      <div class="section-inner">
        <h1>Terms of Use</h1>
        <p>
          These Terms of Use govern your access to and use of the Mental
          Wellness &amp; Relationship Services (MWRS) website. By visiting or
          using this site, you agree to these terms.
        </p>
      </div>
    </section>

    <!-- Content -->
    <section class="terms-body">
      <div class="section-inner">

        <p class="policy-effective">Effective date: March 28, 2026</p>

        <h2>Informational purposes only</h2>
        <p>
          The content on this website is provided for general informational
          purposes only. It is not a substitute for professional medical,
          psychiatric, or psychological advice, diagnosis, or treatment. Always
          consult a qualified health provider with questions about your own
          situation.
        </p>

        <h2>No emergency or crisis services</h2>
        <p>
          This website and our online forms are not monitored for emergencies
          or crisis situations. If you are in immediate danger or experiencing
          a medical or mental health emergency, call 911 or go to the nearest
          emergency room. You may also contact the
          <a href="tel:988">988 Suicide &amp; Crisis Lifeline</a> by calling
          or texting <a href="tel:988">988</a>.
        </p>

        <h2>No provider–patient relationship through the website</h2>
        <p>
          Visiting this website or submitting an online form does not by itself
          create a provider–patient relationship with MWRS or any individual
          clinician. A therapeutic or clinical relationship is only established
          after you have completed the intake process and begun services with a
          specific provider.
        </p>

        <h2>Links to other websites</h2>
        <p>
          Our website may include links to third-party websites or resources.
          These links are provided for convenience only. MWRS does not control
          and is not responsible for the content, privacy practices, or services
          of any third-party websites.
        </p>

        <h2>Use of website content</h2>
        <p>
          All text, graphics, and other content on this site are the property
          of MWRS or are used with permission. You may view, download, or print
          materials for your personal, non-commercial use only. Any other
          reproduction, distribution, or modification of site content requires
          prior written consent.
        </p>

        <h2>Accuracy and updates</h2>
        <p>
          We aim to keep the information on this site current and accurate, but
          details about services, locations, availability, or policies may
          change over time. MWRS does not guarantee that all information on the
          site is complete, up to date, or free from error.
        </p>

        <h2>Limitation of liability</h2>
        <p>
          To the fullest extent permitted by law, MWRS is not liable for any
          damages arising out of or related to your use of this website,
          reliance on its content, or inability to access the site.
        </p>

        <h2>Changes to these terms</h2>
        <p>
          We may update these Terms of Use from time to time. Any changes will
          be posted on this page with an updated effective date. Your continued
          use of the site after changes are posted constitutes acceptance of
          the revised terms.
        </p>
        <p>
          If you have questions about these terms, you may contact our office
          for clarification.
        </p>

      </div>
    </section>

    <!-- CTA -->
    <section class="terms-cta">
      <div class="section-inner">
        <h2>Questions about our policies?</h2>
        <p>
          If you have questions about our Terms of Use, Privacy Policy, or how
          we handle information, you're welcome to reach out to our team.
        </p>
        <a href="/contact-us" class="btn-outline btn-outline--counseling">
          Contact us
        </a>
      </div>
    </section>

  </main>

  <style>
    .terms-page {
      background: #f9fafb;
      min-height: 100vh;
    }

    /* ── Hero ─────────────────────────────────────────── */
    .subpage-hero {
      padding: 10rem 1.5rem 3rem;
      background-color: #fbfbf9;
      background-image: url("/images/paper-texture.webp");
      background-repeat: repeat;
      background-size: 420px 420px;
      border-bottom: 1px solid rgba(15, 23, 42, 0.08);
      text-align: center;
    }

    .subpage-hero h1 {
      font-family: "Belleza", sans-serif;
      font-size: clamp(2rem, 3vw, 2.6rem);
      letter-spacing: 0.16em;
      text-transform: uppercase;
      margin: 0 0 1rem;
      color: #111827;
    }

    .subpage-hero p {
      margin: 0;
      font-size: 1rem;
      line-height: 1.8;
      color: #4b5563;
    }

    /* ── Shared section wrapper ───────────────────────── */
    .section-inner {
      max-width: 900px;
      margin: 0 auto;
    }

    /* ── Body ─────────────────────────────────────────── */
    .terms-body {
      padding: 3rem 1.5rem 3.2rem;
      background-color: #e5e9f3;
      background-image: url("/images/paper-texture.webp");
      background-repeat: repeat;
      background-size: 420px 420px;
      border-bottom: 1px solid rgba(15, 23, 42, 0.08);
    }

    .policy-effective {
      font-size: 0.85rem;
      color: #9ca3af;
      margin: 0 0 2rem;
      letter-spacing: 0.04em;
    }

    .terms-body h2 {
      font-family: "Belleza", sans-serif;
      font-size: 1.2rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      margin: 2rem 0 0.75rem;
      color: #111827;
    }

    .terms-body h2:first-of-type {
      margin-top: 0;
    }

    .terms-body p {
      margin: 0 0 0.9rem;
      font-size: 0.96rem;
      line-height: 1.8;
      color: #4b5563;
    }

    .terms-body a {
      color: #7d6fb3;
      text-decoration: underline;
    }

    /* ── CTA ──────────────────────────────────────────── */
    .terms-cta {
      padding: 3rem 1.5rem 3.5rem;
      background-color: #fbfbf9;
      background-image: url("/images/paper-texture.webp");
      background-repeat: repeat;
      background-size: 420px 420px;
      border-top: 1px solid rgba(15, 23, 42, 0.06);
      text-align: center;
    }

    .terms-cta h2 {
      font-family: "Belleza", sans-serif;
      font-size: 1.2rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      margin: 0 0 1rem;
      color: #111827;
    }

    .terms-cta p {
      max-width: 580px;
      margin: 0 auto 1.6rem;
      font-size: 0.96rem;
      line-height: 1.8;
      color: #4b5563;
    }

    /* ── Outline button ───────────────────────────────── */
    .btn-outline {
      display: inline-block;
      padding: 0.85rem 1.9rem;
      border-radius: 999px;
      border: 1px solid;
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      text-decoration: none;
      background: #ffffff;
      box-shadow: 0 6px 16px rgba(15, 23, 42, 0.12);
      transition: background 0.15s ease, color 0.15s ease,
        box-shadow 0.15s ease, transform 0.15s ease;
    }

    .btn-outline--counseling {
      border-color: #7d6fb3;
      color: #7d6fb3;
    }

    .btn-outline--counseling:hover {
      background: #7d6fb3;
      color: #ffffff;
      transform: translateY(-1px);
      box-shadow: 0 10px 24px rgba(125, 111, 179, 0.3);
    }
  </style>
</Layout>