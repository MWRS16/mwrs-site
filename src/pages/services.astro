---
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Counseling & Medication Services | MWRS"
    description="Explore counseling and psychiatric medication management services offered by MWRS in North Idaho and via telehealth throughout Idaho."
>
    <main class="services-page">
        <!-- Hero -->
        <section class="services-hero">
            <div class="section-inner">
                <h1>Counseling &amp; Medication Services</h1>
                <p>
                    Mental Wellness &amp; Relationship Services (MWRS) offers
                    counseling and psychiatric medication management for
                    individuals, couples, and families across North Idaho.
                </p>
                <a
                    href="/contact-us"
                    class="btn-outline btn-outline--counseling"
                >
                    Get Started
                </a>
            </div>
        </section>

        <!-- Service cards -->
        <section class="services-grid-section">
            <div class="services-grid-inner">
                <div class="services-grid">
                    <!-- Counseling -->
                    <article class="card card--counseling">
                        <p class="card-kicker">Counseling &amp; Therapy</p>
                        <h2 class="card-title">Meet with a counselor</h2>
                        <p class="card-lead">
                            Calm, thoughtful counseling in a judgment-free
                            environment, with options for in-person or
                            telehealth care.
                        </p>
                        <ul class="card-list">
                            <li>Individual counseling for adults and teens</li>
                            <li>Couples and relationship counseling</li>
                            <li>Family counseling</li>
                            <li>
                                Eye Movement Desensitization and Reprocessing
                                (EMDR)
                            </li>
                            <li>
                                Available to Idaho clients via in-person and
                                telehealth visits
                            </li>
                            <li>
                                A good fit if you're looking to talk things
                                through, build insight, or work through life
                                changes
                            </li>
                        </ul>
                        <a
                            href="/contact-us"
                            class="btn-outline btn-outline--counseling"
                        >
                            Start counseling →
                        </a>
                    </article>

                    <!-- Medication -->
                    <article class="card card--medication">
                        <p class="card-kicker card-kicker--medication">
                            Medication Management
                        </p>
                        <h2 class="card-title">Meet with a prescriber</h2>
                        <p class="card-lead">
                            Psychiatric medication management with a focus on
                            collaboration, clarity, and careful follow-up.
                        </p>
                        <ul class="card-list">
                            <li>Psychiatric evaluation for adults and teens</li>
                            <li>Ongoing medication management</li>
                            <li>Lab monitoring when clinically appropriate</li>
                            <li>In-person and telehealth options</li>
                            <li>
                                Available to Idaho clients via in-person and
                                telehealth visits
                            </li>
                            <li>
                                Care is collaborative, with thoughtful
                                adjustments over time based on your response
                            </li>
                        </ul>
                        <a
                            href="/psychiatry"
                            class="btn-outline btn-outline--medication"
                        >
                            Start medication care →
                        </a>
                    </article>
                </div>
            </div>
        </section>

        <!-- Refill + Sliding fee — compact cards -->
        <section class="compact-cards-section">
            <div class="refill-section-inner">
                <article
                    class="refill-card refill-card--neutral"
                    id="sliding-fee"
                >
                    <div class="refill-card-header">
                        <p class="card-kicker">Financial Assistance</p>
                        <h2 class="refill-title">
                            Sliding Fee Discount Program
                        </h2>
                        <p class="refill-intro">
                            MWRS offers discounts based on household size and
                            income for counseling and medication services. No
                            one is denied care due to an inability to pay.
                        </p>
                    </div>
                    <a
                        href="/contact-us"
                        class="btn-outline btn-outline--counseling"
                    >
                        Request information →
                    </a>
                </article>

                <article class="refill-card">
                    <div class="refill-card-header">
                        <p class="card-kicker card-kicker--medication">
                            Existing Patients
                        </p>
                        <h2 class="refill-title">Medication Refill Request</h2>
                        <p class="refill-intro">
                            Already a patient? Request a refill for a current or
                            previously prescribed medication. Allow 1–2 business
                            days for processing.
                        </p>
                    </div>
                    <a
                        href="/medication-refill"
                        class="btn-outline btn-outline--medication"
                    >
                        Request a refill →
                    </a>
                </article>
            </div>
        </section>
    </main>

    <style>
        .services-page {
            background: #f9fafb;
            min-height: 100vh;
        }

        /* ── Hero ─────────────────────────────────────────── */
        .services-hero {
            padding: 10rem 1.5rem 3.5rem;
            background-color: #fbfbf9;
            background-image: url("/images/paper-texture.png");
            background-repeat: repeat;
            background-size: 420px 420px;
            border-bottom: 3px solid #9b8ec4;
            text-align: center;
        }

        .services-hero h1 {
            font-family: "Belleza", sans-serif;
            font-size: clamp(2rem, 3vw, 2.6rem);
            letter-spacing: 0.14em;
            text-transform: uppercase;
            margin: 0 0 1rem;
            color: #111827;
        }

        .services-hero p {
            margin: 0 0 1.75rem;
            font-size: 1rem;
            line-height: 1.7;
            color: #4b5563;
        }

        /* ── Shared section wrapper ───────────────────────── */
        .section-inner {
            max-width: 900px;
            margin: 0 auto;
        }

        /* ── Service cards grid ───────────────────────────── */
        .services-grid-section {
            padding: 3.5rem 1.5rem 4rem;
            background-color: #f9fafb;
            background-image: url("/images/paper-texture.png");
            background-repeat: repeat;
            background-size: 420px 420px;
            border-bottom: 1px solid rgba(15, 23, 42, 0.08);
        }

        .services-grid-inner {
            max-width: 1100px;
            margin: 0 auto;
        }

        .services-grid {
            display: grid;
            gap: 2rem;
        }

        @media (min-width: 900px) {
            .services-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        /* ── Cards ────────────────────────────────────────── */
        .card {
            border-radius: 22px;
            padding: 2.1rem 2rem 2rem;
            background: #ffffff;
            box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .card--counseling {
            border: 1.5px solid rgba(155, 142, 196, 0.5);
        }

        .card--medication {
            border: 1.5px solid rgba(138, 180, 164, 0.5);
        }

        .card-kicker {
            margin: 0;
            font-family: "Belleza", sans-serif;
            text-transform: uppercase;
            letter-spacing: 0.16em;
            font-size: 0.78rem;
            color: #7d6fb3;
        }

        .card-kicker--medication {
            color: #6a9e8e;
        }

        .card-title {
            margin: 0;
            font-size: 1.25rem;
            font-weight: 400;
            letter-spacing: 0.02em;
            color: #111827;
        }

        .card-lead {
            margin: 0.25rem 0 0.75rem;
            font-size: 0.96rem;
            line-height: 1.7;
            color: #4b5563;
        }

        .card-list {
            margin: 0 0 1.2rem;
            padding-left: 1.1rem;
            font-size: 0.95rem;
            line-height: 1.6;
            color: #4b5563;
        }

        .card-list li + li {
            margin-top: 0.2rem;
        }

        /* ── Outline buttons ──────────────────────────────── */
        .btn-outline {
            display: inline-block;
            margin-top: auto;
            padding: 0.75rem 1.6rem;
            border-radius: 999px;
            border: 1px solid;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.14em;
            text-decoration: none;
            background: #ffffff;
            box-shadow: 0 6px 16px rgba(15, 23, 42, 0.1);
            transition:
                background 0.15s ease,
                color 0.15s ease,
                box-shadow 0.15s ease,
                transform 0.15s ease;
            cursor: pointer;
            font-family: inherit;
        }

        .btn-outline--counseling {
            border-color: #7d6fb3;
            color: #7d6fb3;
        }

        .btn-outline--counseling:hover {
            background: #7d6fb3;
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 10px 24px rgba(125, 111, 179, 0.3);
        }

        .btn-outline--medication {
            border-color: #6a9e8e;
            color: #6a9e8e;
        }

        .btn-outline--medication:hover {
            background: #6a9e8e;
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 10px 24px rgba(106, 158, 142, 0.3);
        }

        .btn-outline--neutral {
            border-color: #111827;
            color: #111827;
        }

        .btn-outline--neutral:hover {
            background: #111827;
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 10px 24px rgba(15, 23, 42, 0.2);
        }

        /* ── Filled buttons ───────────────────────────────── */
        .btn-filled {
            margin-top: 1.2rem;
            display: inline-block;
            border-radius: 999px;
            border: 1px solid;
            padding: 0.9rem 1.9rem;
            font-size: 0.95rem;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            cursor: pointer;
            font-family: inherit;
            transition: all 0.15s ease;
        }

        .btn-filled--medication {
            background: #6a9e8e;
            border-color: #6a9e8e;
            color: #ffffff;
            box-shadow: 0 9px 22px rgba(106, 158, 142, 0.3);
        }

        .btn-filled--medication:hover {
            background: #598a7a;
            border-color: #598a7a;
            transform: translateY(-1px);
            box-shadow: 0 14px 32px rgba(106, 158, 142, 0.4);
        }

        .btn-filled--neutral {
            background: #111827;
            border-color: #111827;
            color: #ffffff;
            box-shadow: 0 9px 22px rgba(15, 23, 42, 0.25);
        }

        .btn-filled--neutral:hover {
            background: #1f2937;
            transform: translateY(-1px);
            box-shadow: 0 14px 32px rgba(15, 23, 42, 0.35);
        }

        /* ── Compact cards section ────────────────────────── */
        .compact-cards-section {
            padding: 4rem 1.5rem;
            background-color: #e5e9f3;
            background-image: url("/images/paper-texture.png");
            background-repeat: repeat;
            background-size: 420px 420px;
            border-bottom: 1px solid rgba(15, 23, 42, 0.08);
        }

        .refill-section-inner {
            max-width: 1100px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .refill-card {
            border-radius: 22px;
            padding: 2.2rem 2.4rem;
            background: #ffffff;
            border: 1.5px solid rgba(138, 180, 164, 0.5);
            box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 2rem;
            flex-wrap: wrap;
        }

        .refill-card--neutral {
            border-color: rgba(155, 142, 196, 0.5);
        }

        .refill-card-header {
            flex: 1;
            min-width: 0;
        }

        .refill-title {
            margin: 0.3rem 0 0.6rem;
            font-family: "Belleza", sans-serif;
            font-size: 1.4rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: #111827;
        }

        .refill-intro {
            margin: 0;
            color: #4b5563;
            line-height: 1.75;
            font-size: 0.95rem;
            max-width: 600px;
        }

        @media (max-width: 720px) {
            .refill-card {
                flex-direction: column;
                align-items: flex-start;
                padding: 1.8rem 1.4rem;
            }
        }
    </style>
</Layout>
