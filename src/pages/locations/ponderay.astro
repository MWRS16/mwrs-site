---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Counseling & Medication Services in Ponderay | MWRS"
  description="Counseling and psychiatric medication management in Ponderay, Idaho. In-person sessions at our Highway 200 office, with telehealth options for Idaho residents."
>
  <main class="location-page">

    <!-- Hero -->
    <section class="subpage-hero">
      <div class="section-inner">
        <h1>Ponderay</h1>
        <p>
          MWRS provides counseling and psychiatric medication management in
          Ponderay from our Highway 200 office. Clients can meet with
          counselors and nurse practitioners in person, or combine in-office
          visits with telehealth depending on season and schedule.
        </p>
        <a href="/contact-us" class="btn-outline btn-outline--counseling">
          Start in Ponderay
        </a>
      </div>
    </section>

    <!-- Info card -->
    <section class="location-info-section">
      <div class="location-info-inner">
        <article class="location-info-card">
          <div class="location-info-content">
            <p class="card-kicker">Ponderay Office</p>
            <h2 class="location-info-title">30410 Highway 200</h2>
            <p class="location-info-address">Ponderay, ID 83852</p>
            <div class="location-contact">
              <a href="tel:2082612255">P: 208.261.2255</a>
              <a href="tel:2084737271">F: 208.473.7271</a>
              <a href="mailto:info@mwrservices.org">info@mwrservices.org</a>
            </div>
            <p class="location-info-note">
              Conveniently located on Highway 200 with easy access for clients
              in the Sandpoint and surrounding communities.
            </p>
            <div class="location-services-offered">
              <a href="/services" class="service-tag service-tag--counseling">Counseling</a>
              <a href="/psychiatry" class="service-tag service-tag--medication">Medication Management</a>
              <a href="/telehealth" class="service-tag">Telehealth</a>
            </div>
          </div>
          <div class="location-map">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2714.5!2d-116.5327!3d48.2977!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x549a9e5b5b5b5b5b%3A0x2!2s30410+US-200%2C+Ponderay%2C+ID+83852!5e0!3m2!1sen!2sus!4v1234567890"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="MWRS Ponderay office location"
            ></iframe>
          </div>
        </article>
      </div>
    </section>

    <!-- Service cards -->
    <section class="location-services">
      <div class="location-services-inner">
        <div class="services-grid">

          <article class="card card--counseling">
            <p class="card-kicker">Counseling &amp; Therapy</p>
            <h2 class="card-title">Meet with a counselor</h2>
            <p class="card-lead">
              Individual, couples, and family counseling serving the Sandpoint
              area and surrounding communities.
            </p>
            <ul class="card-list">
              <li>Individual counseling for adults and teens</li>
              <li>Couples and relationship counseling</li>
              <li>Family counseling</li>
              <li>In-person and telehealth options</li>
            </ul>
            <a href="/contact-us" class="btn-outline btn-outline--counseling">
              Start counseling →
            </a>
          </article>

          <article class="card card--medication">
            <p class="card-kicker card-kicker--medication">Medication Management</p>
            <h2 class="card-title">Meet with a prescriber</h2>
            <p class="card-lead">
              Psychiatric evaluation and ongoing medication management in
              Ponderay, in person or via telehealth.
            </p>
            <ul class="card-list">
              <li>Psychiatric evaluation for adults and teens</li>
              <li>Ongoing medication management</li>
              <li>Lab monitoring when clinically appropriate</li>
              <li>In-person and telehealth options</li>
            </ul>
            <a href="/psychiatry" class="btn-outline btn-outline--medication">
              Start medication care →
            </a>
          </article>

        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="location-cta">
      <div class="section-inner">
        <h2>Schedule in Ponderay</h2>
        <p>
          Share a bit about what you're looking for, and our intake team will
          help you get scheduled with a counselor or prescriber at our Ponderay
          office or via telehealth.
        </p>
        <a href="/contact-us" class="btn-outline btn-outline--counseling">
          Start in Ponderay
        </a>
      </div>
    </section>

  </main>

  <style>
    .location-page {
      background: #f9fafb;
      min-height: 100vh;
    }

    /* ── Hero ─────────────────────────────────────────── */
    .subpage-hero {
      padding: 10rem 1.5rem 3.5rem;
      background-color: #fbfbf9;
      background-image: url("/images/paper-texture.png");
      background-repeat: repeat;
      background-size: 420px 420px;
      border-bottom: 1px solid rgba(15, 23, 42, 0.08);
      text-align: center;
    }

    .subpage-hero h1 {
      font-family: "Belleza", sans-serif;
      font-size: clamp(2rem, 3vw, 2.6rem);
      letter-spacing: 0.16em;
      text-transform: uppercase;
      margin: 0 0 1rem;
      color: #111827;
    }

    .subpage-hero p {
      margin: 0 0 1.75rem;
      font-size: 1rem;
      line-height: 1.8;
      color: #4b5563;
    }

    /* ── Shared wrappers ──────────────────────────────── */
    .section-inner {
      max-width: 900px;
      margin: 0 auto;
    }

    /* ── Info card ────────────────────────────────────── */
    .location-info-section {
      padding: 3.5rem 1.5rem 4rem;
      background-color: #ffffff;
      background-image: url("/images/paper-texture.png");
      background-repeat: repeat;
      background-size: 420px 420px;
      border-bottom: 1px solid rgba(15, 23, 42, 0.08);
    }

    .location-info-inner {
      max-width: 1100px;
      margin: 0 auto;
    }

    .location-info-card {
      display: grid;
      grid-template-columns: 1fr 400px;
      border-radius: 22px;
      overflow: hidden;
      border: 1.5px solid rgba(155, 142, 196, 0.5);
      box-shadow: 0 22px 50px rgba(15, 23, 42, 0.1);
      background: #ffffff;
    }

    .location-info-content {
      padding: 2.2rem 2.4rem;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      justify-content: center;
      align-items: flex-start;
    }

    .location-info-title {
      margin: 0;
      font-family: "Belleza", sans-serif;
      font-size: 1.3rem;
      letter-spacing: 0.04em;
      color: #111827;
      font-weight: 400;
    }

    .location-info-address {
      margin: 0;
      font-size: 0.95rem;
      color: #4b5563;
    }

    .location-contact {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      margin: 0.2rem 0;
    }

    .location-contact a {
      font-size: 0.9rem;
      color: #4b5563;
      text-decoration: none;
    }

    .location-contact a:hover {
      color: #7d6fb3;
      text-decoration: underline;
    }

    .location-info-note {
      margin: 0.2rem 0 0;
      font-size: 0.88rem;
      line-height: 1.6;
      color: #6b7280;
    }

    .location-services-offered {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 0.4rem;
    }

    .service-tag {
      display: inline-block;
      padding: 0.3rem 0.8rem;
      border-radius: 999px;
      font-size: 0.75rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      font-family: "Belleza", sans-serif;
      border: 1px solid rgba(15, 23, 42, 0.15);
      color: #4b5563;
      text-decoration: none;
      transition: all 0.15s ease;
    }

    .service-tag:hover { background: rgba(15, 23, 42, 0.06); }

    .service-tag--counseling {
      border-color: rgba(155, 142, 196, 0.6);
      color: #7d6fb3;
    }

    .service-tag--counseling:hover { background: rgba(155, 142, 196, 0.1); }

    .service-tag--medication {
      border-color: rgba(138, 180, 164, 0.6);
      color: #6a9e8e;
    }

    .service-tag--medication:hover { background: rgba(138, 180, 164, 0.1); }

    .location-map {
      min-height: 360px;
    }

    .location-map iframe {
      width: 100%;
      height: 100%;
      min-height: 360px;
      display: block;
      border-radius: 0 20px 20px 0;
    }

    @media (max-width: 900px) {
      .location-info-card {
        grid-template-columns: 1fr;
      }
      .location-map {
        min-height: 260px;
      }
      .location-map iframe {
        border-radius: 0 0 20px 20px !important;
        min-height: 260px;
      }
    }

    /* ── Service cards ────────────────────────────────── */
    .location-services {
      padding: 3.5rem 1.5rem 4rem;
      background-color: #f9fafb;
      background-image: url("/images/paper-texture.png");
      background-repeat: repeat;
      background-size: 420px 420px;
      border-bottom: 1px solid rgba(15, 23, 42, 0.08);
    }

    .location-services-inner {
      max-width: 1100px;
      margin: 0 auto;
    }

    .services-grid {
      display: grid;
      gap: 2rem;
    }

    @media (min-width: 900px) {
      .services-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    .card {
      border-radius: 22px;
      padding: 2.1rem 2rem 2rem;
      background: #ffffff;
      box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .card--counseling { border: 1.5px solid rgba(155, 142, 196, 0.5); }
    .card--medication { border: 1.5px solid rgba(138, 180, 164, 0.5); }

    .card-kicker {
      margin: 0;
      font-family: "Belleza", sans-serif;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      font-size: 0.78rem;
      color: #7d6fb3;
    }

    .card-kicker--medication { color: #6a9e8e; }

    .card-title {
      margin: 0;
      font-size: 1.25rem;
      font-weight: 400;
      color: #111827;
    }

    .card-lead {
      margin: 0.25rem 0 0.5rem;
      font-size: 0.96rem;
      line-height: 1.7;
      color: #4b5563;
    }

    .card-list {
      margin: 0 0 1rem;
      padding-left: 1.1rem;
      font-size: 0.95rem;
      line-height: 1.6;
      color: #4b5563;
      flex: 1;
    }

    .card-list li + li { margin-top: 0.2rem; }

    /* ── CTA ──────────────────────────────────────────── */
    .location-cta {
      padding: 3rem 1.5rem 3.5rem;
      background-color: #fbfbf9;
      background-image: url("/images/paper-texture.png");
      background-repeat: repeat;
      background-size: 420px 420px;
      border-top: 1px solid rgba(15, 23, 42, 0.06);
      text-align: center;
    }

    .location-cta h2 {
      font-family: "Belleza", sans-serif;
      font-size: 1.2rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      margin: 0 0 1rem;
      color: #111827;
    }

    .location-cta p {
      max-width: 580px;
      margin: 0 auto 1.6rem;
      font-size: 0.96rem;
      line-height: 1.8;
      color: #4b5563;
    }

    /* ── Outline buttons ──────────────────────────────── */
    .btn-outline {
      display: inline-block;
      margin-top: auto;
      padding: 0.75rem 1.6rem;
      border-radius: 999px;
      border: 1px solid;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      text-decoration: none;
      background: #ffffff;
      box-shadow: 0 6px 16px rgba(15, 23, 42, 0.1);
      transition: background 0.15s ease, color 0.15s ease,
        box-shadow 0.15s ease, transform 0.15s ease;
    }

    .btn-outline--counseling {
      border-color: #7d6fb3;
      color: #7d6fb3;
    }

    .btn-outline--counseling:hover {
      background: #7d6fb3;
      color: #ffffff;
      transform: translateY(-1px);
      box-shadow: 0 10px 24px rgba(125, 111, 179, 0.3);
    }

    .btn-outline--medication {
      border-color: #6a9e8e;
      color: #6a9e8e;
    }

    .btn-outline--medication:hover {
      background: #6a9e8e;
      color: #ffffff;
      transform: translateY(-1px);
      box-shadow: 0 10px 24px rgba(106, 158, 142, 0.3);
    }
  </style>
</Layout>